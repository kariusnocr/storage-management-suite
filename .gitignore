# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Packaging / build outputs
build/
dist/
*.egg-info/
.eggs/
*.spec.bak

# Unit test / coverage / linter caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# OS / Editor metadata
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Environment & credentials (never commit)
.env
.env.*
*.pem
*.key
*credentials*.json
*secret*.json
token.json

# Local runtime data, SQLite DB & large caches (stored in ~/storage_data outside repo)
storage_data/
runtime_data/
runtime_config/
content_cache/
media_cache/
snapshots/
runs/
*.db
*.db-wal
*.db-shm
*.tmp
*.bak
